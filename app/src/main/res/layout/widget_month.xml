<?xml version="1.0" encoding="utf-8"?>
<!-- "This Month": a heading row (the feature's symbol and name), what you've spent, what's left of your budgets, and
     the next renewal. Tap the heading for the Library, anywhere else for the start screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="11dp">

    <LinearLayout
        android:id="@+id/widget_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/sym_savings"
            android:tint="@color/widget_accent" />
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_month"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_spent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:fontFamily="sans-serif-black"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/widget_budget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_subtext"
        android:textSize="12sp" />
</LinearLayout>
